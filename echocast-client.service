[Unit]
Description=Echocast client (redirects local audio to the Echocast server over SSH)
Documentation=https://github.com/hexploder/echocast
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/echocast client-watch
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
